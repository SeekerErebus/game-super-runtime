# Generated by tools/make-dist.sh. Add a Maintainer line before AUR submission.
pkgname=game-super-runtime
pkgver=@VERSION@
pkgrel=1
pkgdesc='Declarative Linux game launches with Steam, Proton and companion apps'
arch=('x86_64' 'aarch64')
url='@REPOSITORY_URL@'
license=('MIT')
depends=('glibc' 'gcc-libs' 'bash' 'coreutils')
makedepends=('rust' 'cargo')
optdepends=(
  'bubblewrap: private virtual directory views'
  'fuse-overlayfs: ordered mod directory overlays'
  'fuse3: overlay mount lifecycle'
  'xdg-utils: open the browser or desktop text editor'
  'gamemode: performance mode integration'
  'mangohud: performance overlay'
  'gamescope: nested compositor'
  'vkbasalt: Vulkan post processing'
)
source=('@SOURCE@')
sha256sums=('@SHA256@')

prepare() {
  cd "$srcdir/$pkgname-$pkgver"
  export CARGO_HOME="$srcdir/cargo-home"
  cargo fetch --locked
}

build() {
  cd "$srcdir/$pkgname-$pkgver"
  export CARGO_HOME="$srcdir/cargo-home"
  cargo build --frozen --release
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  export CARGO_HOME="$srcdir/cargo-home"
  cargo test --frozen
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  make install DESTDIR="$pkgdir" PREFIX=/usr
}
